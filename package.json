{
  "name": "igovpath",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "concurrently -n ai,web -c blue,green --restart-tries 10 --restart-after 3000 \"pnpm ai\" \"pnpm dev:web\"",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed": "pnpm --filter web db:seed",
    "db:reset": "pnpm --filter web db:reset",
    "import:sita": "pnpm --filter web import:sita",
    "ai": "node scripts/python-ai.mjs run uvicorn main:app --reload --port 8000",
    "demo:reset": "pnpm --filter web demo:reset",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:ai": "node scripts/python-ai.mjs run pytest -q",
    "ai:setup": "node scripts/python-ai.mjs setup",
    "dev:web": "pnpm --filter web dev",
    "bootstrap": "pnpm ai:setup && pnpm db:migrate && pnpm db:seed",
    "prod": "pnpm build && concurrently -n ai,web -c blue,green --restart-tries 10 --restart-after 3000 \"node scripts/python-ai.mjs run uvicorn main:app --port 8000\" \"pnpm --filter web start\""
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
