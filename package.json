{
  "name": "igovpath",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "concurrently -k -n ai,web -c blue,green \"pnpm ai\" \"pnpm dev:web\"",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed": "pnpm --filter web db:seed",
    "db:reset": "pnpm --filter web db:reset",
    "ai": "cd services/ai && .venv/bin/uvicorn main:app --reload --port 8000",
    "demo:reset": "pnpm --filter web demo:reset",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:ai": "cd services/ai && .venv/bin/pytest -q",
    "ai:setup": "cd services/ai && python3.12 -m venv .venv && .venv/bin/pip install -q -r requirements.txt",
    "dev:web": "pnpm --filter web dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
