# iGovPath environment variables
# Copy this file:  cp .env.example .env   then fill in the values.
# .env is git-ignored. NEVER commit real keys.
# See README.md → "Accounts and environment setup" for where each value comes from.

# ── App ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
# Hackathon rule: sample data only. Keep this true.
SAMPLE_DATA_ONLY=true

# ── Database: Neon (Postgres + pgvector) — REQUIRED ───────────────────
# Neon console → your project → Connect → copy both strings.
# Direct (no "-pooler" in host) — used for migrations and seeding:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Pooled (host contains "-pooler") — used by the app at runtime:
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── LLM: which provider the app uses ──────────────────────────────────
# One of: groq | openrouter | ollama
LLM_PROVIDER=groq

# ── Groq — REQUIRED (primary LLM) ─────────────────────────────────────
# console.groq.com → API Keys → Create API Key (starts with gsk_)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Check the exact id in console.groq.com/docs/models before the event
GROQ_MODEL=openai/gpt-oss-120b

# ── OpenRouter — OPTIONAL (backup LLM) ────────────────────────────────
# openrouter.ai → Keys → Create Key (starts with sk-or-)
# Free: 50 req/day; 1,000 req/day after a one-off $10 credit purchase.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick a current ":free" model at openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Ollama — OPTIONAL (offline fallback on a laptop) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
# Optional embeddings for semantic search (small, runs on CPU)
OLLAMA_EMBED_MODEL=bge-m3

# ── Auth: Better Auth (users + logins stored in our Neon database) ──
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app (change when deployed)
BETTER_AUTH_URL=http://localhost:3000
# This email becomes the first admin when it signs up.
# The admin approves officer accounts on /admin/users.
ADMIN_EMAIL=

# ── Demo accounts (optional, used by `pnpm demo:reset`) ───────────────
# Use real team names. The officer is placed in the Eastern Cape Department
# of Social Development; the applicant gets the two amended posts saved.
DEMO_PASSWORD=
DEMO_OFFICER_NAME=
DEMO_OFFICER_EMAIL=
DEMO_APPLICANT_NAME=
DEMO_APPLICANT_EMAIL=

# ── Officer code ──────────────────────────────────────────────────────
# Officers who enter this code get officer access straight away.
# Share it privately. Keep the real code out of GitHub.
OFFICER_CODE=

# ── Website ↔ AI service password ─────────────────────────────────────
# Any long random text. Set the SAME value on both Vercel projects.
# Generate with:  openssl rand -base64 32
AI_SERVICE_KEY=

# ── Admin code ────────────────────────────────────────────────────────
# Entering this on the officer access page makes the person an admin.
# Share it only with people who should manage users. Keep it out of GitHub.
ADMIN_CODE=
